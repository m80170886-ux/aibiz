# Copy this file to ".env" and fill it in. Never upload .env to GitHub.

APP_NAME=BizPilot AI

# REQUIRED in production: a long random text (32+ characters). Keep it secret and never change it later.
SECRET_KEY=

# The email you will register with. This account becomes the owner/admin.
ADMIN_EMAIL=you@example.com

# Database. Leave empty for a local SQLite file (good for testing).
# For hosting use a free Postgres (Neon / Supabase) and paste its connection string here:
# DATABASE_URL=postgresql://user:password@host/dbname
DATABASE_URL=

# AI provider: demo (no key, basic answers) | anthropic | openai (OpenAI-compatible: OpenAI, Groq, OpenRouter, Ollama...)
LLM_PROVIDER=demo
LLM_API_KEY=
# Examples: LLM_MODEL=claude-haiku-5-5   or   LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL=
# Only for provider "openai" when not using OpenAI itself, e.g. https://api.groq.com/openai/v1
LLM_BASE_URL=

# Text shown to clients on the Billing page: how they should pay you.
PAYMENT_INSTRUCTIONS=Send the plan price in USD to: <your payment details here>. Then paste the transaction ID below.

# Optional
# CORS_ORIGINS=https://your-client-site.com
# RATE_LIMIT_PER_MIN=60
# EMAIL_DAILY_LIMIT=100
# TRIAL_MESSAGES=10
